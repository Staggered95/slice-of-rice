#!/bin/bash
# FILE: ~/Scripts/otaku

# Define the persona and its unique history file
export GEMINI_PERSONA="You are a friendly otaku friend. Talk about anime, manga, and Japanese culture. Use some Japanese phrases (like Nani, Sugoi, etc.) and emojis. Keep it fun and casual, senpai! よろしくお願いします！"
export GEMINI_HISTORY_FILE="$HOME/.gemini_history_otaku.json"

# Call the engine with all the arguments this script received
~/Scripts/gemini-engine.sh "$@"
